# kintone 接続設定のサンプルファイル
# このファイルをコピーして `.env` という名前のファイルを作成し、実際の値を入力してください。

# kintoneのベースURL（最後のスラッシュは不要）
# 例: https://subdomain.cybozu.com
KINTONE_BASE_URL=https://your-subdomain.cybozu.com

# ログイン認証情報
KINTONE_USER=your_username
KINTONE_PASSWORD=your_password

# テスト対象アプリID
# 例: 11【入社前研修】受注管理
APP_ID_PARENT=11

# 例: 24【入社前研修】受注明細 (実際の環境に合わせて修正してください)
APP_ID_CHILD=24
